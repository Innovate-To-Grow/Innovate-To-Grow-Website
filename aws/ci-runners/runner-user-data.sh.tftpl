#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1
# Never trace JIT registration credentials into logs.
set +x
trap 'shutdown -h now' EXIT

# A boot failure or abandoned job must not leave a billable machine behind.
# Current jobs time out at 45 minutes; allow ample margin for runner startup.
shutdown -h +90
systemctl start docker
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/aws/amazon-cloudwatch-agent/bin"
export RUNNER_TOOL_CACHE=/opt/hostedtoolcache
# sudo applies its own PATH when starting the agent, so expose the default
# command through a standard system directory as well as the tool cache.
ln -sfn /opt/hostedtoolcache/Python/3.14.10/x64/bin/python /usr/local/bin/python
# The upstream installer normally selects this directory. A baked image skips
# that installer, so registration and ./run.sh need an explicit working dir.
cd /opt/actions-runner
(
# The upstream script uses curl -v for metadata reads. Omit that flag so
# temporary IMDS authentication headers are never copied into startup logs.
${replace(start_runner, " -v ", " ")}
)
