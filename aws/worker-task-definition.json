{
  "family": "__WORKER_TASK_FAMILY__",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__ECS_EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__ECS_TASK_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "itg-background-worker",
      "image": "__IMAGE_URI__",
      "command": ["python", "manage.py", "run_background_worker"],
      "environment": [
        {
          "name": "DJANGO_SETTINGS_MODULE",
          "value": "config.settings.production"
        },
        {
          "name": "BACKGROUND_JOBS_ENABLED",
          "value": "__WORKER_BACKGROUND_JOBS_ENABLED__"
        },
        {
          "name": "BACKGROUND_JOB_METRICS_NAMESPACE",
          "value": "__BACKGROUND_JOB_METRICS_NAMESPACE__"
        },
        {
          "name": "DJANGO_ALLOWED_HOSTS",
          "value": "__DJANGO_ALLOWED_HOSTS__"
        },
        {
          "name": "BACKEND_URL",
          "value": "__BACKEND_URL__"
        },
        {
          "name": "FRONTEND_URL",
          "value": "__FRONTEND_URL__"
        },
        {
          "name": "AWS_STORAGE_BUCKET_NAME",
          "value": "__AWS_STORAGE_BUCKET_NAME__"
        },
        {
          "name": "AWS_S3_REGION_NAME",
          "value": "__AWS_S3_REGION_NAME__"
        },
        {
          "name": "DB_NAME",
          "value": "__DB_NAME__"
        },
        {
          "name": "DB_USER",
          "value": "__DB_USER__"
        },
        {
          "name": "DB_HOST",
          "value": "__DB_HOST__"
        },
        {
          "name": "DB_PORT",
          "value": "__DB_PORT__"
        },
        {
          "name": "DB_CONN_MAX_AGE",
          "value": "__DB_CONN_MAX_AGE__"
        },
        {
          "name": "DB_CONN_HEALTH_CHECKS",
          "value": "__DB_CONN_HEALTH_CHECKS__"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__WORKER_LOG_GROUP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "worker"
        }
      },
      "essential": true,
      "secrets": [
        {
          "name": "DJANGO_SECRET_KEY",
          "valueFrom": "__DJANGO_SECRET_KEY_SECRET_ARN__"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "__DB_PASSWORD_SECRET_ARN__"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "__REDIS_URL_SECRET_ARN__"
        }
      ]
    }
  ]
}
