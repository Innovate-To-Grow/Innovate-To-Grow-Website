{
  "name": "pages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "size": "size-limit",
    "perf:homepage": "node scripts/measure-homepage-slow-3g.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dompurify": "^3.4.13",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "size-limit": "^12.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^8.0.0",
      "unzipper": "^0.12.5"
    },
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "220 kB",
      "gzip": true
    },
    {
      "path": "dist/assets/react-vendor-*.js",
      "limit": "90 kB",
      "gzip": true
    },
    {
      "path": "dist/assets/router-*.js",
      "limit": "45 kB",
      "gzip": true
    }
  ]
}
